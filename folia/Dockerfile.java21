FROM eclipse-temurin:21-jre-jammy@sha256:1eac8b8fee11ca7d6725a48bc5d41992ed1561504ebae25490d2d062847e8269

# Prepares the directories
RUN mkdir -p /app /data \
  && chown 1000:1000 /app /data

# Sets the Folia working data directory
WORKDIR /data

# Defines the Folia download URL and sha256 checksum
# Defaults are for testing only and must be overridden for releases
ARG DOWNLOAD_URL="https://fill-data.papermc.io/v1/objects/f52c408490a0225611e67907a3ca19f7e6da2c6bc899e715d5f46844e7103c39/folia-1.21.11-14.jar"
ARG SHA256_CHECKSUM="sha256:f52c408490a0225611e67907a3ca19f7e6da2c6bc899e715d5f46844e7103c39"

# Downloads the Folia JAR and verifies its checksum
ADD --checksum=${SHA256_CHECKSUM} --chown=1000:1000 ${DOWNLOAD_URL} /app/folia.jar

# Runs Folia as an unprivileged user
USER 1000:1000

# Requires explicit EULA acceptance and sets the default JVM options
ENV ACCEPT_EULA=false \
  JAVA_TOOL_OPTIONS="-Xms2G -Xmx2G"

# Stops Folia gracefully so the data is saved before exit
STOPSIGNAL SIGTERM

# Exposes the default port
EXPOSE 25565

# Periodically checks whether Folia is accepting connections
HEALTHCHECK --interval=30s --start-period=60s --timeout=5s \
  CMD bash -c 'echo > /dev/tcp/127.0.0.1/25565'

# Writes eula.txt from ACCEPT_EULA then starts the Folia instance
CMD ["bash", "-c", "echo \"eula=${ACCEPT_EULA:-false}\" > /data/eula.txt && exec java -jar /app/folia.jar nogui"]
