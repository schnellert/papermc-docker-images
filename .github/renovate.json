
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": [
     "devcontainer",
     "dockerfile",
     "github-actions"
   ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": [
        "/folia/**",
        "/paper/**",
        "/velocity/**"
      ],
      "matchPackageNames": ["eclipse-temurin"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "timezone": "Europe/Berlin"
}
