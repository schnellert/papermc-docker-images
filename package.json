{
  "name": "papermc-docker-images",
  "version": "0.0.0",
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-sh": "^0.20.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1"
    }
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-sh"
    ],
    "overrides": [
      {
        "files": [
          "**/Dockerfile*"
        ],
        "options": {
          "parser": "dockerfile"
        }
      },
      {
        "files": [
          "pnpm-lock.yaml"
        ],
        "options": {
          "requirePragma": true
        }
      }
    ]
  }
}
