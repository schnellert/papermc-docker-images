FROM eclipse-temurin:25-jre-jammy@sha256:dbb43d81099eec91e0800226ed2296d03146ee7857165b95112372ad0d67e87f

# Prepares the directories
RUN mkdir -p /app /data \
   && chown 1000:1000 /app /data

# Sets the Paper working data directory
WORKDIR /data

# Defines the Paper download URL and sha256 checksum
# Defaults are for testing only and must be overridden for releases
ARG DOWNLOAD_URL="https://fill-data.papermc.io/v1/objects/f8e684a4fef2a8b46d03aac049b49d59275e9ce5367dba7c6075cb5780f38470/paper-26.3-223.jar"
ARG SHA256_CHECKSUM="sha256:f8e684a4fef2a8b46d03aac049b49d59275e9ce5367dba7c6075cb5780f38470"

# Downloads the Paper JAR and verifies its checksum
ADD \
   --checksum=${SHA256_CHECKSUM} \
   --chown=1000:1000 \
   ${DOWNLOAD_URL} \
   /app/paper.jar

# Runs Paper as an unprivileged user
USER 1000:1000

# Requires explicit EULA acceptance and sets the default JVM options 
ENV ACCEPT_EULA=false \
    JAVA_TOOL_OPTIONS="-Xms2G -Xmx2G"

# Stops Paper gracefully so the data is saved before exit
STOPSIGNAL SIGTERM

# Exposes the default port
EXPOSE 25565

# Periodically checks whether Paper is accepting connections
HEALTHCHECK --interval=30s --start-period=60s --timeout=5s \
   CMD bash -c 'echo > /dev/tcp/127.0.0.1/25565'

# Writes eula.txt from ACCEPT_EULA then starts the Paper instance
CMD ["bash", "-c", "echo \"eula=${ACCEPT_EULA:-false}\" > /data/eula.txt && exec java -jar /app/paper.jar nogui"]
