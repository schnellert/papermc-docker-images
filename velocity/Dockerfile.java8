FROM eclipse-temurin:8-jre-jammy@sha256:49b31e882495abeb1118de417ee696bdc929d2de238730920f1468025fc393a4

# Prepares the directories
RUN mkdir -p /app /data \
  && chown 1000:1000 /app /data

# Sets the Velocity working data directory
WORKDIR /data

# Defines the Velocity download URL and sha256 checksum
# Defaults are for testing only and must be overridden for releases
ARG DOWNLOAD_URL="https://fill-data.papermc.io/v1/objects/d6ba2c934eb956b3aea5381135fb6c5763bb3a50a85022671fac6f5bfed63843/velocity-1.1.9-447.jar"
ARG SHA256_CHECKSUM="sha256:d6ba2c934eb956b3aea5381135fb6c5763bb3a50a85022671fac6f5bfed63843"

# Downloads the Velocity JAR and verifies its checksum
ADD --checksum=${SHA256_CHECKSUM} --chown=1000:1000 ${DOWNLOAD_URL} /app/velocity.jar

# Runs Velocity as an unprivileged user
USER 1000:1000

# Sets the default JVM options
ENV JAVA_TOOL_OPTIONS="-Xms512M -Xmx1G"

# Stops Velocity gracefully so the data is saved before exit
STOPSIGNAL SIGTERM

# Exposes the default port
EXPOSE 25565

# Periodically checks whether Velocity is accepting connections
HEALTHCHECK --interval=30s --start-period=60s --timeout=5s \
  CMD bash -c 'echo > /dev/tcp/127.0.0.1/25565'

# Starts the Velocity instance
CMD ["java", "-jar", "/app/velocity.jar"]
