FROM eclipse-temurin:21-jre-jammy@sha256:dff6eb46527bd293a3c06bbbe9e64e8c9f91f01905b5abbdad31761c03059d2c

# Prepares the directories
RUN mkdir -p /app /data \
  && chown 1000:1000 /app /data

# Sets the server working data directory
WORKDIR /data

# Defines the server download URL and sha256 checksum
# Must be provided at build time, there are no defaults
ARG DOWNLOAD_URL=""
ARG SHA256_CHECKSUM=""

# Downloads the server JAR and verifies its checksum
ADD --checksum=${SHA256_CHECKSUM} --chown=1000:1000 ${DOWNLOAD_URL} /app/server.jar

# Adds the entrypoint script that starts the server
COPY --chmod=755 docker-entrypoint.sh /docker-entrypoint.sh

# Runs the server as an unprivileged user
USER 1000:1000

# Keeps the download URL available at runtime so the entrypoint can detect the project
ENV DOWNLOAD_URL=${DOWNLOAD_URL}

# Stops the server gracefully so the data is saved before exit
STOPSIGNAL SIGTERM

# Exposes the default port
EXPOSE 25565

# Periodically checks whether the server is accepting connections
HEALTHCHECK --interval=30s --start-period=60s --timeout=5s \
  CMD bash -c 'echo > /dev/tcp/127.0.0.1/25565'

# Writes eula.txt (Paper and Folia only) and starts the server via the entrypoint script
CMD ["/docker-entrypoint.sh"]
